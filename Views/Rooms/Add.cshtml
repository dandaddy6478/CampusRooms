@model Room

<h1>Add a room</h1>

<form method="post" asp-controller="Rooms" asp-action="Add">
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Seats" class="form-label"></label>
        <input asp-for="Seats" class="form-control" />
        <span asp-validation-for="Seats" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="HasProjector" class="form-check-input" />
        <label asp-for="HasProjector" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
    <a asp-controller="Rooms" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
